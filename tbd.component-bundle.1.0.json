{
  "manifests": {
    "tbd/tbd-component-bundle": {
      "manifest": {
        "bundles": {
          "Tbd\\ComponentBundle\\TbdComponentBundle": ["all"]
        },
        "copy-from-recipe": {
          "config/": "%CONFIG_DIR%",
          "assets/": "assets/"
        },
        "add-lines": [
          {
            "file": "assets/bootstrap.js",
            "position": "bottom",
            "warn_if_missing": true,
            "content": "// component-bundle: register controllers (inside vendor/)\nconst tbdControllers = require.context(\n    '@symfony/stimulus-bridge/lazy-controller-loader!../vendor/tbd/tbd-component-bundle/assets/controllers',\n    true,\n    /_controller\\.[jt]sx?$/\n);\n\nfor (const key of tbdControllers.keys()) {\n    const mod = tbdControllers(key);\n\n    const name = key\n        .replace(/^\\.\\//, '')\n        .replace(/\\.[jt]sx?$/, '')\n        .replace(/_controller$/, '')\n        .replace(/\\//g, '--')\n        .replace(/_/g, '-');\n\n    app.register(name, mod.default);\n}\n"
          }
        ]
      },
      "files": {
        "config/packages/tbd_component.yaml": {
          "contents": [
            "tbd_component:",
            "  button:",
            "    variants:",
            "      primary: 'text-white fill-white bg-orange-400 hover:bg-orange-500 focus:ring-orange-300'",
            "    sizes:",
            "      sm: 'px-2 py-1 text-xs'",
            "      md: 'px-4 py-2 text-sm'",
            "      lg: 'px-6 py-4 text-base'",
            "",
            "  icon:",
            "    sizes:",
            "      sm: 'w-3 h-3'",
            "      md: 'w-4 h-4'",
            "      lg: 'w-5 h-5'",
            "",
            "twig_component:",
            "  defaults:",
            "    Tbd\\TbdComponentBundle\\Twig\\Components\\TBD\\: 'components/tbd/'",
            ""
          ],
          "executable": false
        }
      },
      "ref": "6db4bfe590ff80a4660edac6f22b1670eebd8d2d"
    }
  }
}