{
  "manifests": {
    "tbd/twig-component-bundle": {
      "manifest": {
        "bundles": {
          "Tbd\\TwigComponentBundle\\TbdTwigComponentBundle": [
            "all"
          ]
        },
        "copy-from-recipe": {
          "config/": "%CONFIG_DIR%"
        },
        "post-install-output": [
          "This package is built to work with Tailwind CSS, Flowbite and Hotwire Turbo (Turbo Frames).",
          "",
          "Tailwind CSS:",
          "  - If Tailwind CSS is not installed yet, install it by running:",
          "      npm install -D tailwindcss postcss autoprefixer",
          "",
          "  - Tailwind v3 configuration (tailwind.config.js):",
          "    - Ensure the following paths are included in the `content` array so Tailwind can detect the components:",
          "        './vendor/tbd/twig-component-bundle/templates/**/*.html.twig',",
          "        './vendor/tbd/twig-component-bundle/src/**/*.php',",
          "",
          "  - Tailwind v4 configuration (no tailwind.config.js required):",
          "    - Add these sources to your main CSS entry (e.g. assets/styles/app.css):",
          "        @source '../../vendor/tbd/twig-component-bundle/templates/**/*.html.twig';",
          "        @source '../../vendor/tbd/twig-component-bundle/src/**/*.php';",
          "",
          "Flowbite:",
          "  - This bundle uses Flowbite components.",
          "  - If Flowbite is not installed yet, install it by running:",
          "      npm install flowbite",
          "",
          "  - Add Flowbite JavaScript (recommended when using Turbo):",
          "      import 'flowbite/dist/flowbite.turbo.js';",
          "",
          "  - Tailwind v3 configuration:",
          "    - Include Flowbite in the `content` array:",
          "        './node_modules/flowbite/**/*.js',",
          "    - Register the Flowbite plugin:",
          "        plugins: [require('flowbite/plugin')],",
          "",
          "  - Tailwind v4 configuration:",
          "    - Add Flowbite as a source in your main CSS entry:",
          "        @source '../../node_modules/flowbite/**/*.js';",
          "    - Register the Flowbite plugin:",
          "        @plugin 'flowbite/plugin';",
          "",
          "Hotwire Turbo:",
          "  - If Hotwire Turbo is not installed yet, install it by running:",
          "      npm install @hotwired/turbo"
        ]
      },
      "files": {
        "config/packages/tbd_twig_component.yaml": {
          "contents": [
            "tbd_twig_component:",
            "",
            "twig_component:",
            "  defaults:",
            "    Tbd\\TwigComponentBundle\\Twig\\Components\\TBD\\: 'components/tbd/'",
            ""
          ],
          "executable": false
        }
      },
      "ref": "0a78d3166ac21bc58d87a1386633cdb23d34382c"
    }
  }
}
